# /etc/vinimon/api.env (systemd) ou --env-file (Docker). Modelo de PRODUÇÃO.
# NUNCA coloque segredo real neste arquivo. Os valores "troque..." abaixo são de exemplo
# e o env.ts (S4) recusa a aplicação com NODE_ENV=production enquanto eles estiverem aqui.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
APP_ORIGIN=https://chamados.suaempresa.com.br
TRUST_PROXY=127.0.0.1
# systemd: /var/lib/vinimon/anexos · Docker (volume montado em /data/anexos): /data/anexos
UPLOAD_DIR=/var/lib/vinimon/anexos
API_DOCS=false
MAX_ANEXO_MB=10
# Papel vinimon_app; sslmode=require se o banco for remoto (S117).
DATABASE_URL=postgresql://vinimon_app:troque-senha-app@127.0.0.1:5432/vinimon?sslmode=require
# Gerar com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Valor de exemplo abaixo (decodifica para texto com "troque", de propósito): substitua pelo valor gerado.
CSRF_SECRET=dHJvcXVldHJvcXVldHJvcXVldHJvcXVldHJvcXVlMTI=
# Gerar com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))" (exatamente 32 bytes)
ENCRYPTION_KEY=dHJvcXVldHJvcXVldHJvcXVldHJvcXVldHJvcXVlMzQ=
# Opcional (e-mail): SMTP_URL=smtps://usuario:senha@smtp.suaempresa.com.br:465 e MAIL_FROM=  (ver docs/operacao.md)
JOBS_HABILITADOS=true
SOCKET_REVALIDAR_MS=60000
