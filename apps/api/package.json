{
  "name": "@vinimon/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch --clear-screen=false src/server.ts",
    "build": "prisma generate && tsdown",
    "start": "node --enable-source-maps dist/server.mjs",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run --passWithNoTests",
    "test:sla-tz": "TZ=UTC vitest run src/modules/sla && TZ=Asia/Tokyo vitest run src/modules/sla",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "seed:dev": "tsx prisma/seed-dev.ts",
    "cli": "tsx scripts/cli.ts",
    "importar:v1": "tsx scripts/importar-v1/index.ts",
    "db:dev:recriar": "docker compose exec -T postgres psql -U vinimon -d postgres -c 'DROP DATABASE IF EXISTS vinimon WITH (FORCE)' -c 'CREATE DATABASE vinimon OWNER vinimon' && DATABASE_URL=postgresql://vinimon:vinimon@localhost:5432/vinimon prisma migrate deploy",
    "db:teste:recriar": "docker compose exec -T postgres psql -U vinimon -d postgres -c 'DROP DATABASE IF EXISTS vinimon_test WITH (FORCE)' -c 'CREATE DATABASE vinimon_test OWNER vinimon' && DATABASE_URL=postgresql://vinimon:vinimon@localhost:5432/vinimon_test prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/proxy-addr": "5.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fastify/swagger": "9.9.2",
    "@fastify/under-pressure": "9.2.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@scalar/fastify-api-reference": "1.75.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-pt-br": "4.1.1",
    "close-with-grace": "2.5.0",
    "content-disposition": "3.0.0",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "file-type": "22.2.0",
    "luxon": "3.7.2",
    "otplib": "13.5.0",
    "pg-boss": "12.38.0",
    "rate-limiter-flexible": "11.2.3",
    "socket.io": "4.8.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@types/luxon": "3.7.6",
    "@types/node": "catalog:",
    "@vinimon/shared": "workspace:*",
    "fast-check": "4.10.2",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.4",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
